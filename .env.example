# Copy to .env and fill in. Keep comments on their own lines: "KEY=   # note" would make the note the value.
#
# API keys are optional here: each user normally adds their own in the app (Settings), stored encrypted.
# Only the first (owner) account and the command-line tools fall back to these.

# AI checks and writing (free): https://console.groq.com/keys . Several keys: comma-separated, used in order.
GROQ_API_KEY=
# Optional AI fallback after all Groq keys: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Optional, Naukri jobs ($5/month free): https://console.apify.com/settings/integrations
APIFY_API_KEY=
# Optional: Google results for contact search: https://serper.dev
SERPER_API_KEY=
# Optional: email outreach: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Optional: 0 turns off the AI job-title pre-screen
JF_TITLE_SCREEN=1

# ---- 24/7 cloud (see README: "Make it run 24/7") ----
# Telegram bot token from @BotFather (alerts and buttons)
TELEGRAM_BOT_TOKEN=
# Written by cloud/deploy.py: the Worker's address and the shared secret
FP_CLOUD_URL=
FP_CLOUD_SECRET=
# owner/repo of your copy of github_reader/ (the LinkedIn + Indeed reader on GitHub Actions)
FP_READER_REPO=

# ---- Self-hosting the full app on a server (private, invite-only) — see docs/DEPLOY.md ----
# local = this computer only: opens straight into the owner's account, no sign-in (default).
# cloud = deployed: Google sign-in, invites, no automatic sign-in.
FP_MODE=local
# "Sign in with Google": OAuth client ID (Web application) from console.cloud.google.com
GOOGLE_CLIENT_ID=
# Your Google email: only it can create the first (owner) account
FP_OWNER_EMAIL=
# Optional: invited emails, comma-separated (you can also manage invites in Settings)
FP_ALLOWED_EMAILS=
# Server secret for Google users' encrypted keys (deploy/setup_server.sh fills it in). Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = users/server.key is created. Back it up: losing it locks Google users' saved API keys.
FP_SECRET_KEY=
# Your name and a contact / grievance email, shown on the Terms and Privacy pages
FP_OPERATOR_NAME=
FP_CONTACT_EMAIL=
# 1 = allow username/password sign-up for everyone (not invite-only)
FP_PASSWORD_SIGNUP=0
